# 本机路径配置模板。用法：
#   cp local/env.sh.example local/env.sh   然后按本机情况改
# env.sh 已进 .gitignore，不会被提交。
#
# REPO_DIR 不用写在这里 —— local/_common.sh 会从脚本自身位置自动推导。

# ---------------------------------------------------------------------------
# BrainTreebank 数据
# ---------------------------------------------------------------------------
# 组装好的数据根目录：元数据（transcripts / localization / electrode_labels /
# subject_metadata / subject_timings）是实体文件，all_subject_data/ 下的 raw .h5
# 是指向下面 RAW_DIR 的符号链接。微调流程（3_ / 4_ / 5_）用这个。
BRAINTREEBANK_DIR="${REPO_DIR}/braintreebank_data"

# 原始数据盘（274G，只读共享）。注意它的 h5 是嵌套一层的：
#   sub_1_trial000.h5/sub_1_trial000.h5
# 所以不能直接当 raw_brain_data_dir 用，得走上面 BRAINTREEBANK_DIR 的符号链接。
BRAINTREEBANK_RAW_DIR="/HWFS/yuezhifeng_lab/chenying/data/BrainTreebank"

# ---------------------------------------------------------------------------
# 预训练权重
# ---------------------------------------------------------------------------
# 从 HuggingFace 下载时务必指定 local_dir=pretrained_weights/，
# 否则 snapshot_download 会把 README.md / .gitattributes 铺到仓库根目录，
# 覆盖 upstream 的 README。
WEIGHTS_DIR="${REPO_DIR}/pretrained_weights"
